class_name DungeonGenerator
extends Node2D
## Explorable structure (type 3): one castle hall generated from a seed.
##
## Responsibilities are split: CastleLayout builds pure data, CastleTiles owns
## the atlas and collision, CastlePainter paints the four layers and this node
## only handles lifecycle, spawn and exit. It is independent from the chunked
## world and never instantiates nor keeps the player.

## Emitted once per `start()` when the player steps on the top floor exit.
signal exit_requested
## Emitted after the exit door climbs one floor; the hall is already rebuilt and
## the caller must move the player to the new `spawn_point`.
signal floor_changed(floor: int)

const LayoutScript := preload("res://scripts/structures/castle/castle_layout.gd")
const TilesScript := preload("res://scripts/structures/castle/castle_tiles.gd")
const PainterScript := preload("res://scripts/structures/castle/castle_painter.gd")
const TILE_SIZE := 32
## Player origin is ~27 px above the feet; 30 leaves a 3 px fall.
const SPAWN_ABOVE_PX := 30.0

@export_group("Layout")
## Hall width in tiles (64 x 32 = 2048 px).
@export var width_tiles: int = 64
## Minimum guaranteed floors.  The actual count is derived from the seed
## via a cascade of 50 % rolls (see `_compute_floor_count`).
@export var min_floors: int = 3
## Hard cap on floors (cascade stops here); the castle has 3..10 floors.
@export var max_floors: int = 10

@export_group("Test")
## Seed used when the scene is opened on its own; 0 = wait for `start()`.
@export var auto_start_seed: int = 0
## Floor generated by `auto_start_seed`.
@export var auto_start_floor: int = 0

## Marker where the caller must place the player.
var spawn_point: Marker2D

var _platform_layer: TileMapLayer
var _wall_layer: TileMapLayer
var _back_layer: TileMapLayer
var _decor_layer: TileMapLayer
var _exit_area: Area2D
var _dungeon_seed: int = 0
var _floor_index: int = 0
var _exit_emitted := false
var _bound := false
var _void_backdrop: Polygon2D
## Last generated data, exposed read-only for the headless probe.
var _layout: Dictionary = {}


func _ready() -> void:
	_bind_nodes()
	_build_void_backdrop()
	if auto_start_seed != 0:
		start(auto_start_seed, auto_start_floor)


## Generates floor `floor` (0-based) from `seed`. The same pair always paints the
## same layout; calling it again replaces the current hall. Never uses the global
## RNG.
func start(seed: int, floor: int = 0) -> void:
	_bind_nodes()
	if spawn_point == null:
		return
	_dungeon_seed = seed
	_floor_index = clampi(floor, 0, floor_count() - 1)
	_generate()


## Number of floors (at least 1), computed deterministically from the seed.
## Always at least `min_floors`; then each extra floor up to `max_floors`
## requires an independent 50 % roll (cascade: 4 needs roll1, 5 needs
## roll1 AND roll2, …).  Uses its own RNG so the layout RNG is unaffected.
func floor_count() -> int:
	return _compute_floor_count(_dungeon_seed)


## Compute floor count from a seed without touching the global RNG.
func _compute_floor_count(seed: int) -> int:
	var rng := RandomNumberGenerator.new()
	# Use a distinct salt so this doesn't collide with per-floor layout seeds.
	rng.seed = seed ^ 0xDEADF100
	var count := min_floors
	while count < max_floors:
		if rng.randf() < 0.5:
			count += 1
		else:
			break
	return count


## Seed of the current layout.
func current_seed() -> int:
	return _dungeon_seed


## Floor currently painted (0-based).
func current_floor() -> int:
	return _floor_index


## Pure save data: the layout is rebuilt from seed + floor, not stored tile by tile.
func save_state() -> Dictionary:
	return {"seed": _dungeon_seed, "floor": _floor_index}


## Rebuilds the dungeon from `save_state()`. No file access here on purpose.
func load_state(state: Dictionary) -> void:
	start(int(state.get("seed", 0)), int(state.get("floor", 0)))


func _generate() -> void:
	_exit_emitted = false
	_platform_layer.clear()
	_wall_layer.clear()
	_back_layer.clear()
	if _decor_layer != null:
		_decor_layer.clear()
	_layout = LayoutScript.new().build(_dungeon_seed, _floor_index, width_tiles)
	if _layout.is_empty():
		push_error("DungeonGenerator: the layout is empty.")
		return
	_wall_layer.tile_set = TilesScript.build_walls()
	_platform_layer.tile_set = TilesScript.build_platforms()
	var plain := TilesScript.build_plain()
	_back_layer.tile_set = plain
	if _decor_layer != null:
		_decor_layer.tile_set = plain
	PainterScript.paint(
		_back_layer,
		_decor_layer,
		_wall_layer,
		_platform_layer,
		_layout
	)
	_place_spawn(_layout["spawn_cell"])
	_place_exit(_layout["exit_cell"])


## Opaque polygon behind Back. The color is the atlas' own purple, not a custom
## dark: the original border art ends exactly against it, without a cutout or an
## invented transition. The world parallax lives at z = -100 and Back at z = -4,
## so z = -5 hides the normal background inside the dungeon. This is deliberately
## a world-space Node2D, not a CanvasLayer, so it also follows the camera.
func _build_void_backdrop() -> void:
	if _void_backdrop != null:
		return
	var pad := 4096.0
	var right := maxi(width_tiles, LayoutScript.HALL_WIDTH) * TILE_SIZE + pad
	var bottom := LayoutScript.HALL_HEIGHT * TILE_SIZE + pad
	_void_backdrop = Polygon2D.new()
	_void_backdrop.name = "DungeonVoid"
	_void_backdrop.z_index = -5
	_void_backdrop.color = Color(0.2588235, 0.2274510, 0.3176471, 1.0)
	_void_backdrop.polygon = PackedVector2Array([
		Vector2(-pad, -pad),
		Vector2(right, -pad),
		Vector2(right, bottom),
		Vector2(-pad, bottom),
	])
	add_child(_void_backdrop)


func _place_spawn(cell: Vector2i) -> void:
	spawn_point.position = Vector2(
		cell.x * TILE_SIZE + TILE_SIZE / 2.0,
		cell.y * TILE_SIZE - SPAWN_ABOVE_PX
	)


func _place_exit(cell: Vector2i) -> void:
	_exit_area.position = Vector2(
		cell.x * TILE_SIZE + TILE_SIZE / 2.0,
		cell.y * TILE_SIZE
	)


func _on_exit_body_entered(body: Node2D) -> void:
	if _exit_emitted or not body.is_in_group("player"):
		return
	_exit_emitted = true
	# Deferred so the rebuild (and the caller's teleport) happens outside the
	# Area2D physics query flush.
	_step_forward.call_deferred()


## The exit pad is the staircase: rebuild the hall one floor up and let the
## caller move the player. Only the top floor returns to the world.
func _step_forward() -> void:
	if _floor_index + 1 < floor_count():
		start(_dungeon_seed, _floor_index + 1)
		# Already outside the physics flush: the caller can move the player now.
		floor_changed.emit(_floor_index)
		return
	exit_requested.emit.call_deferred()


func _bind_nodes() -> void:
	if _bound:
		return
	_platform_layer = get_node_or_null("Platforms") as TileMapLayer
	_wall_layer = get_node_or_null("Walls") as TileMapLayer
	_back_layer = get_node_or_null("Back") as TileMapLayer
	_decor_layer = get_node_or_null("Decor") as TileMapLayer
	_exit_area = get_node_or_null("Exit") as Area2D
	spawn_point = get_node_or_null("spawn_point") as Marker2D
	if (
		_platform_layer == null
		or _wall_layer == null
		or _back_layer == null
		or _exit_area == null
		or spawn_point == null
	):
		push_error("DungeonGenerator: the scene needs Platforms, Walls, Back, Exit and spawn_point.")
		return
	_exit_area.body_entered.connect(_on_exit_body_entered)
	_bound = true
