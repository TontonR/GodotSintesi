class_name DungeonGenerator
extends Node2D
## Explorable structure MVP (type 3): a two-floor side-view room-and-door
## dungeon generated from a seed, independent from the chunked world.
##
## The dungeon paints its own tiles and owns its exit, but it never instantiates
## nor keeps the player: the caller places it on `spawn_point` and reacts to
## `exit_requested`. Switching floors is a fresh `start()`, so the world hook can
## regenerate without rebuilding the node.

## Emitted once per `start()` when the player steps on the floor exit.
signal exit_requested

const TILE_SIZE := 16
## Physics layer of the world; the player's `collision_mask` is 1.
const WALL_LAYER := 1
## Dark cells painted around the dungeon so the camera never shows the sky.
const MARGIN_TILES := 40
## Ground rows painted under the walkable floor, to read as solid ground.
const FLOOR_THICKNESS := 3
## Rows of the ceiling band.
const CEILING_THICKNESS := 2
## The player's origin is ~27 px above its feet; 30 leaves a 3 px fall.
const SPAWN_ABOVE_PX := 30.0
const GROUND_TEXTURE := preload("res://assets/map/tile/ground_tile.png")

@export_group("Layout")
## Dungeon width in tiles.
@export var width_tiles: int = 150
## Row of the walkable floor.
@export var floor_row: int = 40
## Rows between the floor and the ceiling band (minimum 3).
@export var interior_height_tiles: int = 12
## Doorway clearance above the floor, in tiles (minimum 4: the player is ~3.4).
@export var door_height_tiles: int = 6
## Rooms per floor: the array size is the number of floors.
@export var rooms_per_floor: Array[int] = [7, 9]
## Narrowest room, in tiles (narrow ones read as corridors).
@export var room_width_min: int = 8
## Widest room, in tiles; the last room may take the remainder.
@export var room_width_max: int = 22

@export_group("Test")
## Seed used when the scene is opened on its own; 0 = wait for `start()`.
@export var auto_start_seed: int = 0
## Floor generated by `auto_start_seed`.
@export var auto_start_floor: int = 0

## Marker where the caller must place the player.
var spawn_point: Marker2D

var _floor_layer: TileMapLayer
var _wall_layer: TileMapLayer
var _back_layer: TileMapLayer
var _exit_area: Area2D
var _rng := RandomNumberGenerator.new()
var _rooms: Array[Rect2i] = []
var _dungeon_seed: int = 0
var _floor_index: int = 0
var _exit_emitted := false
var _bound := false


func _ready() -> void:
	_bind_nodes()
	if auto_start_seed != 0:
		start(auto_start_seed, auto_start_floor)


## Generates floor `floor` (0-based) from `seed`. The same pair always paints the
## same layout; calling it again replaces the current floor. Never uses the
## global RNG.
func start(seed: int, floor: int = 0) -> void:
	_bind_nodes()
	if spawn_point == null:
		return
	_dungeon_seed = seed
	_floor_index = clampi(floor, 0, floor_count() - 1)
	_rng.seed = seed ^ (_floor_index * 7919)
	_generate()


## Number of floors (`rooms_per_floor` size, at least 1).
func floor_count() -> int:
	return maxi(1, rooms_per_floor.size())


## Seed of the current layout.
func current_seed() -> int:
	return _dungeon_seed


## Floor currently painted (0-based).
func current_floor() -> int:
	return _floor_index


## Pure save data: the layout is rebuilt from seed + floor, not stored tile by tile.
func save_state() -> Dictionary:
	return {"seed": _dungeon_seed, "floor": _floor_index}


## Rebuilds the dungeon from `save_state()`. No file access here on purpose.
func load_state(state: Dictionary) -> void:
	start(int(state.get("seed", 0)), int(state.get("floor", 0)))


func _generate() -> void:
	_exit_emitted = false
	_floor_layer.clear()
	_wall_layer.clear()
	_back_layer.clear()
	_rooms = _build_rooms()
	_paint()
	_place_spawn(_rooms[0])
	_place_exit(_rooms[_rooms.size() - 1])


## Splits the width into seeded rooms: the floor is one connected hall and each
## room after the first starts with a partition wall that has a doorway.
func _build_rooms() -> Array[Rect2i]:
	var rooms: Array[Rect2i] = []
	var min_width := maxi(room_width_min, 2)
	var count := clampi(
		_room_count(),
		2,
		maxi(2, floori(width_tiles / float(min_width)))
	)
	var remaining := width_tiles
	var x := 0
	for i in count:
		var width := remaining
		if i < count - 1:
			var rooms_left := count - i - 1
			var max_width := mini(room_width_max, remaining - rooms_left * min_width)
			width = _rng.randi_range(min_width, maxi(min_width, max_width))
		rooms.append(Rect2i(x, floor_row, width, 1))
		x += width
		remaining -= width
	return rooms


func _room_count() -> int:
	if _floor_index < rooms_per_floor.size():
		return maxi(2, rooms_per_floor[_floor_index])
	return 2


func _paint() -> void:
	var plain := _build_tileset(false)
	var solid := _build_tileset(true)
	_floor_layer.tile_set = solid
	_wall_layer.tile_set = solid
	_back_layer.tile_set = plain
	var ceiling_row := _ceiling_row()
	var door := _door_height()
	# Dark fill first: everything behind the floor, the ceiling and the walls.
	for y in range(-MARGIN_TILES, floor_row + MARGIN_TILES):
		for x in range(-MARGIN_TILES, width_tiles + MARGIN_TILES):
			var back_cell := Vector2i(x, y)
			_back_layer.set_cell(back_cell, 0, _tile_for(back_cell, 5))
	# Ground: solid full-square tiles, so there is no pit to fall into.
	for x in range(width_tiles):
		for row in FLOOR_THICKNESS:
			var ground_cell := Vector2i(x, floor_row + row)
			_floor_layer.set_cell(ground_cell, 0, _tile_for(ground_cell, 0))
		for row in CEILING_THICKNESS:
			var ceiling_cell := Vector2i(x, ceiling_row - row)
			_wall_layer.set_cell(ceiling_cell, 0, _tile_for(ceiling_cell, 2))
	# Side walls close the hall.
	for y in range(ceiling_row - CEILING_THICKNESS + 1, floor_row + FLOOR_THICKNESS):
		_wall_layer.set_cell(Vector2i(0, y), 0, _tile_for(Vector2i(0, y), 3))
		var right := Vector2i(width_tiles - 1, y)
		_wall_layer.set_cell(right, 0, _tile_for(right, 3))
	# One partition per room after the first, with a doorway at the bottom.
	for i in range(1, _rooms.size()):
		var column_x := _rooms[i].position.x
		for y in range(ceiling_row, floor_row - door):
			var wall_cell := Vector2i(column_x, y)
			_wall_layer.set_cell(wall_cell, 0, _tile_for(wall_cell, 4))


func _ceiling_row() -> int:
	return floor_row - maxi(interior_height_tiles, 3)


## The player is ~3.4 tiles tall, so a shorter doorway would block the floor.
func _door_height() -> int:
	return clampi(door_height_tiles, 4, maxi(4, interior_height_tiles - 2))


## Hash instead of an RNG, so a rebuild paints the same tile on every cell.
func _tile_for(cell: Vector2i, salt: int) -> Vector2i:
	return Vector2i(absi(cell.x * 31 + cell.y * 17 + salt * 13) % 3, 1)


## TileSet built in code from the current ground texture: the fill row of the
## 3x4 atlas, with a full-square collision only when `with_collision` is true.
func _build_tileset(with_collision: bool) -> TileSet:
	var tile_set := TileSet.new()
	tile_set.tile_size = Vector2i(TILE_SIZE, TILE_SIZE)
	if with_collision:
		tile_set.add_physics_layer()
		tile_set.set_physics_layer_collision_layer(0, WALL_LAYER)
	var source := TileSetAtlasSource.new()
	source.texture = GROUND_TEXTURE
	source.texture_region_size = Vector2i(TILE_SIZE, TILE_SIZE)
	tile_set.add_source(source, 0)
	var half := TILE_SIZE / 2.0
	var square := PackedVector2Array([
		Vector2(-half, -half),
		Vector2(half, -half),
		Vector2(half, half),
		Vector2(-half, half),
	])
	for column in 3:
		var coords := Vector2i(column, 1)
		source.create_tile(coords)
		if not with_collision:
			continue
		var data := source.get_tile_data(coords, 0)
		data.add_collision_polygon(0)
		data.set_collision_polygon_points(0, 0, square)
	return tile_set


func _place_spawn(room: Rect2i) -> void:
	var cell := room.get_center()
	spawn_point.position = Vector2(
		cell.x * TILE_SIZE + TILE_SIZE / 2.0,
		cell.y * TILE_SIZE - SPAWN_ABOVE_PX
	)


func _place_exit(room: Rect2i) -> void:
	var cell := room.get_center()
	_exit_area.position = Vector2(
		cell.x * TILE_SIZE + TILE_SIZE / 2.0,
		cell.y * TILE_SIZE
	)


func _on_exit_body_entered(body: Node2D) -> void:
	if _exit_emitted or not body.is_in_group("player"):
		return
	_exit_emitted = true
	exit_requested.emit()


func _bind_nodes() -> void:
	if _bound:
		return
	_floor_layer = get_node_or_null("Floor") as TileMapLayer
	_wall_layer = get_node_or_null("Walls") as TileMapLayer
	_back_layer = get_node_or_null("Back") as TileMapLayer
	_exit_area = get_node_or_null("Exit") as Area2D
	spawn_point = get_node_or_null("spawn_point") as Marker2D
	if (
		_floor_layer == null
		or _wall_layer == null
		or _back_layer == null
		or _exit_area == null
		or spawn_point == null
	):
		push_error("DungeonGenerator: the scene needs Floor, Walls, Back, Exit and spawn_point.")
		return
	_exit_area.body_entered.connect(_on_exit_body_entered)
	_bound = true
